{
  "name": "aurastream-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend REST API service for AuraStream Music Streaming with Cloudflare D1 support",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc && node -e \"const fs=require('fs'); fs.copyFileSync('src/database/schema.sql', 'dist/database/schema.sql');\"",
    "start": "node dist/server.js",
    "seed": "tsx src/database/seed.ts",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "winston": "^3.17.0",
    "yt-search": "^2.12.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workerd-windows-64": "^1.20250718.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "wrangler": "^3.107.0"
  }
}
